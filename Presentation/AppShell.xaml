<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Presentation.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Presentation"
    xmlns:displayView="clr-namespace:Presentation.Views.MainDisplay"
    xmlns:detailsView="clr-namespace:Presentation.Views.Details"
    xmlns:filterView="clr-namespace:Presentation.Views.Filters"
    Title="Presentation">


    <TabBar>
        <Tab Title="News">
            <ShellContent
                ContentTemplate="{DataTemplate displayView:MainDisplay}"
                Route="MainDisplay"/>


        
        </Tab>
        <Tab Title="Filter">
            <ShellContent 
                ContentTemplate="{DataTemplate filterView:ApplyFilter}" 
                Title="Filter"/>
        </Tab>
    </TabBar>
    <ShellContent 
                ContentTemplate="{DataTemplate detailsView:ArticleDetails}"
                Route="ArticleDetails"/>









</Shell>
